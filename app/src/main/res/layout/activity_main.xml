<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gemi_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <co.neonexus.geminein.WaveformView
            android:id="@+id/waveformView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="@string/audio_waveform" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="56dp"
            android:text="@string/ready_when_you_are"
            android:textColor="#C6D4FF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/listenButton"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/gemi_button_background"
            android:backgroundTint="@null"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:text="@string/speak_to_gemi_nein"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</FrameLayout>
